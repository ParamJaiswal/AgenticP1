# ====================================================================
# AgenticP1 — AI Calling Agent Platform — Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your values.
# Most defaults are optimized for near-zero cost operation.
# ====================================================================

# === App ===
APP_NAME=AgenticP1
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====================================================================
# LLM (Language Model) — GROQ FREE TIER IS THE DEFAULT!
# Groq provides FREE API access to Llama 3 models:
#   - 14,400 requests/day
#   - Ultra-fast inference (no GPU needed on your server)
#   - Get your free key at: https://console.groq.com
# ====================================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=groq          # groq | ollama | together | openai
LLM_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# For self-hosted Ollama (FREE, unlimited, runs locally):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# Cheap cloud fallbacks (only used if Groq fails):
TOGETHER_API_KEY=          # https://together.ai — $0.18/1M tokens
OPENAI_API_KEY=            # https://platform.openai.com — $0.15/1M tokens (gpt-4o-mini)

# ====================================================================
# STT (Speech-to-Text) — GROQ WHISPER API IS DEFAULT (FREE!)
# Groq's Whisper API is free tier and very fast.
# Fallback: faster-whisper runs locally on CPU with tiny model.
# ====================================================================
STT_PROVIDER=groq_whisper  # groq_whisper | faster_whisper | vosk
WHISPER_MODEL_SIZE=tiny    # tiny | small | medium (larger = more accurate, slower)
VOSK_MODEL_PATH=./data/models/vosk

# ====================================================================
# TTS (Text-to-Speech) — gTTS IS DEFAULT (FREE, needs internet)
# Piper TTS is the best offline option (neural, fast, CPU-friendly).
# Edge TTS (Microsoft) is free and high quality.
# ====================================================================
TTS_PROVIDER=gtts          # piper | edge_tts | gtts
PIPER_VOICE=en_US-amy-low
PIPER_MODEL_PATH=./data/models/piper
EDGE_TTS_VOICE=en-US-JennyNeural
TTS_LANGUAGE=en

# ====================================================================
# Telephony — TELNYX IS DEFAULT (cheapest at ~$0.005/min!)
# Compared to Twilio ($0.013/min), Telnyx saves ~60% on call costs.
# Get started at: https://telnyx.com
# ====================================================================
TELEPHONY_PROVIDER=telnyx  # telnyx | twilio
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxx
TELNYX_CONNECTION_ID=your_connection_id
TELNYX_PHONE_NUMBER=+15551234567

# Twilio fallback (optional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ====================================================================
# Database — SQLite for dev (zero cost), PostgreSQL for production
# ====================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/agenticp1.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agenticp1

# ====================================================================
# Redis — used for caching LLM responses (reduces API calls)
# ====================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ====================================================================
# Auth
# ====================================================================
JWT_SECRET=change-this-to-a-random-64-char-string-in-production!!
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# ====================================================================
# Knowledge Base (ChromaDB — embedded, no external service needed)
# ====================================================================
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2   # Free, runs on CPU, very fast
RAG_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ====================================================================
# Billing (Stripe — optional, leave blank to start with manual billing)
# ====================================================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ====================================================================
# Call Settings
# ====================================================================
CALL_MAX_DURATION_SECONDS=1800
SILENCE_THRESHOLD_SECONDS=2.0
INTERRUPTION_THRESHOLD_SECONDS=0.5
RECORDINGS_DIR=./data/recordings

# ====================================================================
# Frontend
# ====================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
